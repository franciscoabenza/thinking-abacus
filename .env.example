OPENAI_API_KEY=your_openai_api_key_here
PORT=5174
HOST=127.0.0.1

# The voice model that conducts the conversation.
LIVE_MODEL=gpt-live-1
# The backend it delegates reasoning and tool selection to.
LIVE_BACKEND_MODEL=gpt-5.6-terra
# Abacus's voice. See the GPT-Live voice table for the full set.
LIVE_VOICE=marin
# "responses" lets OpenAI run the backend; "client" hands task reasoning
# back to the browser (no second model, no tool schemas).
LIVE_DELEGATION=responses

# Set this before exposing the server to the internet. Visitors then need
# https://your-host/?k=<this value> once; the browser remembers it.
VOICE_ACCESS_KEY=
